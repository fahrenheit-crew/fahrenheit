<!-- fkelava 18/09/26 18:09
This is a special project whose sole purpose is to fetch assets for .NET debugging and hosting
from your system-wide .NET SDK install using the SDK's MSBuild properties.

Do not modify or unload it. See `src/stage0/inc/dbgshim/README.md`, `src/stage1/inc/nethost/README.md`.
-->

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
	    <EnableDefaultItems>false</EnableDefaultItems>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Diagnostics.DbgShim.$(RuntimeIdentifier)" Version="10.0.745401" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="__FhCopyDbgshim" Condition="$([MSBuild]::IsOsPlatform('Windows'))" BeforeTargets="Build">
        <!--
        The below should be $(PkgMicrosoft_Diagnostics_DbgShim_$(RuntimeIdentifier)), but nested property expansion
        does not exist in MSBuild. Therefore, we make do and need to remember to fix this manually if we ever switch bitness here.
        -->
        <PropertyGroup>
            <DbgShimDll>$(PkgMicrosoft_Diagnostics_DbgShim_win-x86)/runtimes/$(RuntimeIdentifier)/native/dbgshim.dll</DbgShimDll>
        </PropertyGroup>

        <Copy SourceFiles="$(DbgShimDll)" DestinationFolder="$(_FhOutDirBin)" />
    </Target>

    <Target Name="__FhCopyNethost" Condition="$([MSBuild]::IsOsPlatform('Windows'))" BeforeTargets="Build">
        <PropertyGroup>
            <NetHostDir>$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Host.$(RuntimeIdentifier)/$(BundledNETCoreAppPackageVersion)/runtimes/$(RuntimeIdentifier)/native</NetHostDir>
            <NetHostInc>$(NetHostDir)/nethost.h;$(NetHostDir)/coreclr_delegates.h;$(NetHostDir)/hostfxr.h</NetHostInc>
            <NetHostLib>$(NetHostDir)/nethost.lib</NetHostLib>
            <NetHostDll>$(NetHostDir)/nethost.dll</NetHostDll>

            <DestDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'stage1', 'inc', 'nethost'))</DestDir>
        </PropertyGroup>

        <MakeDir Directories="$(DestDir)" />

        <Copy SourceFiles="$(NetHostInc)" DestinationFolder="$(DestDir)" />
        <Copy SourceFiles="$(NetHostLib)" DestinationFolder="$(DestDir)" />
        <Copy SourceFiles="$(NetHostDll)" DestinationFolder="$(_FhOutDirBin)" />
    </Target>
</Project>
