  <PropertyGroup>
    <!-- [fkelava 24/12/25 02:25]
    It seems that 'msbuild -t:Publish' doesn't really deal with C++ projects well.
    It attempts to find and copy a standalone manifest file, ignoring the fact
    the MSVC linker will embed one into the S0 binary.
    
    As we want the build process to be:
    > msbuild .\Fahrenheit.slnx
    > msbuild -t:Publish .\Fahrenheit.slnx
    
    we simply set OutDir instead, and mark Stage0 unpublishable.
    Stage1 is already a C++ DLL and considered implicitly unpublishable.
    
    See comment at L253 in Microsoft.Common.CurrentVersion.targets for the exact semantics.
    -->
    <PublishableProject>false</PublishableProject>
    <IntDir>$(_FhBaseIntermediateOutputPath)</IntDir>
    <OutDir>$(_FhOutDirBin)</OutDir>
    <TargetName>fhstage0</TargetName>
  </PropertyGroup>
